{
  "manifest_version": 3,
  "name": "EIP-7702 Revoker",
  "version": "1.0.0",
  "description": "Secure tool to revoke malicious EIP-7702 delegations",
  "action": {
    "default_popup": "index.html",
    "default_title": "EIP-7702 Revoker"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*/*"
  ]
}