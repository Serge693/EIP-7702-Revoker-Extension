{
  "manifest_version": 3,
  "name": "EIP-7702 Revoker",
  "version": "1.0.0",
  "description": "Secure tool to revoke malicious EIP-7702 delegations",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "EIP-7702 Revoker",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*/*"
  ]
}
